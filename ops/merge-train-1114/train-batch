#!/usr/bin/env python3
"""train-batch: fold every GATE GREEN PR that main has left behind into ONE train PR, gate it once, let merge-ready-watch merge it.

  train-batch select               rows "PR sha branch behind" for open PRs whose newest GATE GREEN names their head and that are
                                   behind main (public API reads, or gh / GH_TOKEN when available)
  train-batch run [PR[=sha] ...]   select (or take the given PRs), then build, gate, push, publish (below). --dry: only try the
                                   merges and report skips, no push/gate/hold. --min N (default 2). --no-publish: stop after the push.
  train-batch finish               for published trains: once the train PR merged, comment "merged via #N" on each folded PR and
                                   close it; release the hold file
  train-batch hold [--except REF]  exit 0 and print why while a train is gating (merge-ready-watch must then merge nothing but
                                   the PR whose head ref is REF); exit 1 when free. A hold ends by itself after HOLD_MIN (90) min.

run = (1) ext/merge-train-<MMDD>-<HHMM> := origin/main + each PR head, one --no-ff merge each with ops/merge-rush-1113/merge_batch.sh's
conflict policy (a PR that conflicts is skipped and reported, a PR whose head moved since its green is skipped); the branch is pushed
at once, which is also the hold flag for boxes that cannot write the coordinator's file (rpc workers: git push works, gh does not);
(2) one gate-shard run (suite vs main, NEW-RED rule, export dry-run); if main moved meanwhile it is merged in and re-gated (a delta gate, max 3 rounds);
(3) publish: open the PR (body lists the folded PRs), post "GATE GREEN <full sha>: ..." on it. Without gh/GH_TOKEN (rpc4) the texts are
left in the state dir for the coordinator: pr-body.md, gate-comment.md, close-<pr>.md. Nothing is merged, approved or bypassed here.
Env: TRAIN_STATE (default /home/boki/cj/merge-train), TRAIN_WORK (default ../train-work next to the repo), GATE (gate script, tests),
REPO_SLUG, HOLD_MIN, GS_* (gate-shard)."""
import json, os, re, shutil, subprocess, sys, time, urllib.request

HERE = os.path.dirname(os.path.realpath(__file__))
REPO = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
SLUG = os.environ.get("REPO_SLUG", "OrriBogdan2/project-boki")
STATE = os.path.realpath(os.environ.get("TRAIN_STATE", "/home/boki/cj/merge-train"))
WORK = os.path.realpath(os.environ.get("TRAIN_WORK", os.path.join(REPO, "..", "train-work")))
HOLD_FILE = os.path.join(STATE, "HOLD")
HOLD_MIN = int(os.environ.get("HOLD_MIN", "90"))
BRANCH_RE = re.compile(r"^ext/merge-train-\d{4}-\d{4}$")
GREEN_RE = re.compile(r"GATE GREEN ([0-9a-f]{10,40})")


def log(*a):
    line = time.strftime("%Y-%m-%d %H:%M:%SZ", time.gmtime()) + " " + " ".join(str(x) for x in a)
    print(line, flush=True)
    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "train.log"), "a") as f:
        f.write(line + "\n")


def git(*a, cwd=None, check=False):
    p = subprocess.run(["git", "-C", cwd or REPO] + list(a), capture_output=True, text=True)
    if check and p.returncode:
        sys.exit(f"git {' '.join(a)} failed: {p.stderr.strip()[:300]}")
    return p.stdout.strip()


def can_write():
    if os.environ.get("GH_TOKEN"):
        return True
    return subprocess.run("command -v gh >/dev/null && gh auth status >/dev/null 2>&1", shell=True).returncode == 0


def api(path, data=None, method=None):
    """GitHub REST: gh api when logged in, else GH_TOKEN, else the public API (reads only)."""
    url = f"https://api.github.com/repos/{SLUG}/{path}"
    body = json.dumps(data) if data is not None else None
    if not os.environ.get("GH_TOKEN") and subprocess.run("command -v gh >/dev/null && gh auth status >/dev/null 2>&1", shell=True).returncode == 0:
        cmd = ["gh", "api", f"repos/{SLUG}/{path}", "-X", method or ("POST" if body else "GET")] + (["--input", "-"] if body else [])
        p = subprocess.run(cmd, input=body, capture_output=True, text=True)
        return json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else None
    req = urllib.request.Request(url, data=body.encode() if body else None, method=method or ("POST" if body else "GET"))
    if os.environ.get("GH_TOKEN"):
        req.add_header("Authorization", "Bearer " + os.environ["GH_TOKEN"])
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except Exception as e:
        log("api", path, "failed:", e)
        return None


def comments(pr):
    out, page = [], 1
    while True:
        c = api(f"issues/{pr}/comments?per_page=100&page={page}")
        if c is None:
            sys.exit(f"GitHub API failed reading PR #{pr} comments (rate limit?): no train decision made")
        out += c
        if len(c) < 100:
            return out
        page += 1


def select():
    """Rows (pr, sha, branch, behind) for open PRs whose newest GATE GREEN is their current head and that main has left behind."""
    git("fetch", "-q", "origin", "main")
    rows = []
    opened = api("pulls?state=open&base=main&per_page=100")
    if opened is None:
        sys.exit("GitHub API failed listing open PRs: no train decision made")
    for pr in opened:
        n, sha, ref = pr["number"], pr["head"]["sha"], pr["head"]["ref"]
        if pr.get("draft") or BRANCH_RE.match(ref) or not pr["head"]["repo"] or pr["head"]["repo"]["full_name"] != SLUG:
            continue
        git("fetch", "-q", "origin", f"+refs/pull/{n}/head:refs/remotes/pr/{n}")
        behind = git("rev-list", "--count", f"{sha}..origin/main")
        if not behind.isdigit() or int(behind) == 0:  # checked first: every comments call costs API quota (60/h without a token)
            continue
        got = comments(n)
        greens = [m.group(1) for c in got for m in [GREEN_RE.search(c["body"])] if m]
        if greens and sha.startswith(greens[-1]):
            rows.append((n, sha, ref, int(behind)))
    return rows


def hold_active(except_ref=None):
    """(branch, minutes) of the live train hold, else None. Sources: the HOLD file and unmerged ext/merge-train-<stamp> branches."""
    found = []
    if os.path.exists(HOLD_FILE):
        h = json.load(open(HOLD_FILE))
        found.append((h["branch"], h["start"]))
    git("fetch", "-q", "origin", "main", "+refs/heads/ext/merge-train-*:refs/remotes/origin/ext/merge-train-*")
    for line in git("for-each-ref", "--format=%(refname:strip=3)", "refs/remotes/origin/ext/merge-train-*").split():
        if BRANCH_RE.match(line) and subprocess.run(["git", "-C", REPO, "merge-base", "--is-ancestor", f"origin/{line}", "origin/main"]).returncode != 0:
            first = git("log", "--first-parent", "--format=%ct", f"origin/main..origin/{line}").splitlines()
            found.append((line, int(first[-1]) if first else time.time()))
    for branch, start in found:
        age = (time.time() - start) / 60
        if age >= HOLD_MIN:
            log(f"hold {branch} released: {age:.0f} min >= {HOLD_MIN} min cap, the train did not merge")
            if os.path.exists(HOLD_FILE) and json.load(open(HOLD_FILE))["branch"] == branch:
                os.remove(HOLD_FILE)
        elif branch != except_ref:
            return branch, age
    return None


def sh_gate(main_tree, cand_tree, out):
    gate = os.environ.get("GATE") or os.path.join(HERE, "gate-shard")
    subprocess.run(["bash", gate, main_tree, cand_tree, out], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=dict(os.environ, GS_TAG="tb" + str(os.getpid())))
    try:
        return open(os.path.join(out, "summary.txt")).readline().strip()
    except OSError:
        return ""


def fresh_tree(path, sha):
    if not os.path.exists(os.path.join(path, ".git")):
        git("worktree", "add", "-q", "--detach", path, sha, check=True)
    git("reset", "-q", "--hard", sha, cwd=path, check=True)
    git("clean", "-fdq", "-e", ".godot", cwd=path)


def merge_in(cand, items, out, tag):
    """Merge [(label, sha)] into cand with merge_batch.sh's policy; returns {label: conflict files} for the skipped ones."""
    lst, skips = os.path.join(out, f"list-{tag}.txt"), os.path.join(out, f"skips-{tag}.txt")
    open(lst, "w").write("".join(f"{lab} {sha}\n" for lab, sha in items))
    open(skips, "w").close()
    rush = os.path.join(cand, "ops/merge-rush-1113/merge_batch.sh")
    subprocess.run(["bash", rush, lst, skips], cwd=cand, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {l.split()[0]: l.split("conflict:", 1)[1].strip() for l in open(skips) if "conflict:" in l}


def regate(cand, branch, old_main, new_main, out, rnd):
    """Main moved: regate-run merges it into the branch and gates only the checks whose inputs changed (4 min, a full gate is 10-50);
    without regate-run the merge is done here and everything is gated again. Returns the new GATE GREEN/RED summary line."""
    sha, rg = git("rev-parse", "HEAD", cwd=cand), os.path.join(out, f"regate-{rnd}")
    tool = os.environ.get("REGATE_RUN", shutil.which("regate-run"))
    if tool:
        env = dict(os.environ, BOKI_REPO=REPO, REGATE_WORK=os.path.join(WORK, "regate"))
        subprocess.run([tool, "0", branch, sha, sha, rg], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        res = open(os.path.join(rg, "result")).read() if os.path.exists(os.path.join(rg, "result")) else "ERROR no result"
        log(f"main {old_main[:10]} -> {new_main[:10]}, delta gate {rnd}: {res.strip()[:120]}")
        if not res.startswith("GREEN"):
            return ""
        git("fetch", "-q", "origin", branch)
        git("reset", "-q", "--hard", f"origin/{branch}", cwd=cand)
        return "GATE GREEN " + open(os.path.join(rg, "comment.md")).read().split(": ", 1)[1].strip()
    merge_in(cand, [("origin/main", new_main)], out, f"m{rnd}")
    git("push", "-q", "origin", f"HEAD:refs/heads/{branch}", cwd=cand)
    fresh_tree(os.path.join(WORK, "main-regate"), new_main)
    summary = sh_gate(os.path.join(WORK, "main-regate"), cand, os.path.join(out, f"gate-{rnd}"))
    log(f"main {old_main[:10]} -> {new_main[:10]}, full re-gate {rnd}: {summary}")
    return summary


def run(args):
    dry = "--dry" in args
    publish = "--no-publish" not in args
    minimum = int(args[args.index("--min") + 1]) if "--min" in args else 2
    ids = [a for a in args if re.match(r"^\d+(=[0-9a-f]+)?$", a)]
    t0 = time.time()
    git("fetch", "-q", "origin", "main", check=True)
    main = git("rev-parse", "origin/main")
    if ids:
        prs = []
        for a in ids:
            n, _, want = a.partition("=")
            git("fetch", "-q", "origin", f"+refs/pull/{n}/head:refs/remotes/pr/{n}", check=True)
            prs.append((int(n), git("rev-parse", f"pr/{n}"), "", 0))
            if want and not prs[-1][1].startswith(want):
                log(f"PR #{n}: head {prs[-1][1][:10]} is not the green {want[:10]}, skipped"); prs.pop()
    else:
        prs = select()
    if len(prs) < minimum:
        log(f"{len(prs)} green-but-behind PRs ({' '.join('#%d' % p[0] for p in prs)}): fewer than {minimum}, no train")
        return 0
    stamp = time.strftime("%m%d-%H%M", time.gmtime())
    branch, out = f"ext/merge-train-{stamp}", os.path.join(STATE, stamp)
    os.makedirs(out, exist_ok=True)
    cand, mtree = os.path.join(WORK, f"cand-{stamp}"), os.path.join(WORK, f"main-{stamp}")
    fresh_tree(cand, main)
    skipped = merge_in(cand, [(f"pr/{n}", sha) for n, sha, _, _ in prs], out, "1")
    folded = [p for p in prs if f"pr/{p[0]}" not in skipped]
    for lab, files in skipped.items():
        log(f"{lab}: SKIPPED, conflicts with main or the others in: {files}")
    log(f"train {stamp}: main {main[:10]} + {' '.join('#%d' % p[0] for p in folded)} ({len(skipped)} skipped)")
    if len(folded) < minimum or dry:
        log("dry run, nothing pushed" if dry else "fewer than the minimum merged cleanly, no train")
        return 0
    json.dump({"branch": branch, "start": time.time()}, open(HOLD_FILE, "w"))
    git("push", "-q", "origin", f"HEAD:refs/heads/{branch}", cwd=cand, check=True)  # the branch is also the hold flag for other boxes
    log(f"pushed {branch} {git('rev-parse', 'HEAD', cwd=cand)[:10]}; hold set")
    fresh_tree(mtree, main)
    summary = sh_gate(mtree, cand, os.path.join(out, "gate-1"))
    log(f"gate 1: {summary or 'no summary (import failure?)'}")
    for rnd in (2, 3, 4):  # main moved during the gate: merge it in and gate the delta
        git("fetch", "-q", "origin", "main")
        new_main = git("rev-parse", "origin/main")
        if not summary.startswith("GATE GREEN") or new_main == main:
            break
        summary = regate(cand, branch, main, new_main, out, rnd)
        main = new_main
    sha = git("rev-parse", "HEAD", cwd=cand)
    if not summary.startswith("GATE GREEN"):
        os.remove(HOLD_FILE)  # a red train must not block main for the rest of the cap: free the hold, drop the train branch
        git("push", "-q", "origin", "--delete", branch)
        log(f"train {stamp} RED: {summary or 'gate failed'}; hold released, {branch} deleted")
        return 1
    if subprocess.run(["git", "-C", REPO, "merge-base", "--is-ancestor", "origin/main", sha]).returncode != 0:
        log(f"train {stamp}: main moved again after 3 gates, not publishing"); return 1
    title = f"Merge train {stamp}: " + " ".join(f"#{p[0]}" for p in folded)
    lines = [f"- #{n} `{(ref or git('log', '-1', '--format=%s', sha_)[:60])}` {sha_[:10]}" for n, sha_, ref, _ in folded]
    body = (f"One gated merge of {len(folded)} PRs that were GATE GREEN but behind main, so their greens stopped going stale.\n\n"
            + "\n".join(lines) + ("\n\nSkipped (conflict): " + "; ".join(f"{k} {v}" for k, v in skipped.items()) if skipped else "")
            + f"\n\nBuilt on origin/main {main[:10]} with `train-batch run`. The folded PRs get a \"merged via\" comment and are closed once this merges.")
    comment = f"GATE GREEN {sha}: {summary[len('GATE GREEN '):]} (train of {len(folded)} PRs, gated on main {main[:10]}, {(time.time() - t0) / 60:.0f} min)"
    for name, text in (("pr-body.md", body), ("gate-comment.md", comment)):
        open(os.path.join(out, name), "w").write(text + "\n")
    meta = {"stamp": stamp, "branch": branch, "folded": [p[0] for p in folded], "sha": sha, "main": main, "pr": None, "title": title, "minutes": round((time.time() - t0) / 60)}
    if publish and can_write():
        made = api("pulls", {"title": title, "head": branch, "base": "main", "body": body})
        if made:
            meta["pr"] = made["number"]
            api(f"issues/{made['number']}/comments", {"body": comment})
            log(f"train PR #{made['number']} opened, GATE GREEN {sha[:10]} posted")
    else:
        log(f"no gh/GH_TOKEN here: texts in {out} (pr-body.md, gate-comment.md), open the PR from {branch} and post the comment")
    json.dump(meta, open(os.path.join(out, "meta.json"), "w"))
    return 0


def finish():
    for d in sorted(os.listdir(STATE)) if os.path.isdir(STATE) else []:
        mp = os.path.join(STATE, d, "meta.json")
        if not os.path.exists(mp) or os.path.exists(os.path.join(STATE, d, "finished")):
            continue
        meta = json.load(open(mp))
        if not meta.get("pr"):
            continue
        tr = api(f"pulls/{meta['pr']}")
        if not tr or tr["state"] == "open":
            continue
        if tr.get("merged"):
            for n in meta["folded"]:
                text = f"merged via #{meta['pr']} (merge train {meta['stamp']})"
                if (api(f"pulls/{n}") or {}).get("state") == "open":
                    api(f"issues/{n}/comments", {"body": text})
                    api(f"pulls/{n}", {"state": "closed"}, "PATCH")
                    log(f"PR #{n}: closed, {text}")
            log(f"train {meta['stamp']} merged as #{meta['pr']} ({meta.get('minutes')} min gate-to-PR)")
        else:
            log(f"train {meta['stamp']} PR #{meta['pr']} closed unmerged; folded PRs left open")
        open(os.path.join(STATE, d, "finished"), "w").close()
        if os.path.exists(HOLD_FILE) and json.load(open(HOLD_FILE))["branch"] == meta["branch"]:
            os.remove(HOLD_FILE)


def main_():
    cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("", [])
    if cmd == "select":
        for r in select():
            print(*r)
    elif cmd == "run":
        return run(args)
    elif cmd == "finish":
        finish()
    elif cmd == "hold":
        h = hold_active(args[1] if args[:1] == ["--except"] else None)
        if h:
            print(f"HOLD {h[0]} {h[1]:.0f} min old (cap {HOLD_MIN})")
            return 0
        return 1
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main_())
