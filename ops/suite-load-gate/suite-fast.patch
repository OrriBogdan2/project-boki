 for p in $PODS; do h=${p%%:*}; sl=${p#*:}; [ "$sl" = "$p" ] && sl=8
   OUT=$OUT GW=$GW SUITE_POD_KEY=$PODK bash ${SUITE_POD_BIN:-/home/boki/bin/suite-pod} $h $sl > $OUT/pod-$h.log 2>&1 & PODPIDS="$PODPIDS $!"; done
