{
	"items": {
		"tonic": {"area": "self: the drinker, rising green motes while they drink", "does": "heals the drinker 42 after a 1 s open drink", "ends": "a green flash as the heal lands; the motes stop if a hit spills it"},
		"deep_draught": {"area": "self: the drinker, slow blue drops and motes for the 5 s drink", "does": "heals the drinker to full; they crawl while drinking", "ends": "a big blue flash at full health; the drops stop if a hit spills it"},
		"lostway_scroll": {"area": "self: pages turn round the reader for the 4 s read", "does": "sends the reader to a random spot on the map", "ends": "a lilac ghost where they stood and a flash where they land (_put); the pages stop if a hit spills it"},
		"omen_draught": {"area": "self while drinking; then a ring pulses on each Blight Warden for the squad", "does": "shows the drinker's squad every Blight Warden for 30 s", "ends": "the warden rings stop pulsing after 30 s"},
		"armor_kit": {"area": "self: steel sparks round the body for the 1.6 s repair", "does": "repairs the user's armor; they are open and slow while repairing", "ends": "a white-steel flash as the armor comes back; the sparks stop if a hit spills it"},
		"medkit": {"area": "self: one green rise", "does": "heals 40 and adds 20 armor at once", "ends": "at once: the rise is the whole of it"},
		"smoke": {"area": "the cloud itself (3.6 m, the gameplay edge of who it hides)", "does": "hides everyone inside it", "ends": "the cloud shrinks away over its last second (8 s)"},
		"jump_pad": {"area": "the pad (its top sits low until it arms after 2 s, then pulses)", "does": "launches whoever steps on it, keeping their speed", "ends": "it blinks for its last 1.5 s (30 s, or 10 s after its first launch), then a puff"},
		"gust_fan": {"area": "the fan pad (its top pulses while it stands)", "does": "throws whoever steps on it high up and along", "ends": "it blinks for its last 1.5 s (60 s), then a puff"},
		"hawk_whistle": {"area": "its reach (120 m) flashes once as a ring round the user; each rival found wears a mark", "does": "shows every rival in reach for 4 s", "ends": "the mark over each rival goes when the 4 s reveal ends"},
		"scanner": {"area": "its reach (26 m) flashes once as a ring round the user; each rival found wears a mark", "does": "shows every rival within 26 m for 3 s", "ends": "the mark over each rival goes when the 3 s reveal ends"},
		"lookout_lantern": {"area": "the lantern totem and a faint ring in the owner's colour at its 14 m watch edge (gameplay)", "does": "shows every rival inside the ring; a rival inside wears a mark", "ends": "the totem shrinks away after 60 s, with a puff"},
		"toss_satchel": {"area": "the satchel sitting in its 1.4 m patch (gameplay: step in to take it)", "does": "the first hurt body to step in heals 60% of its health over 5 s (a hit stops it)", "ends": "taken: a green rise and the patch shrinks; untaken it shrinks away after 30 s"},
		"twin_gate": {"area": "two upright portals, their 2 m patches (gameplay) and a lit link between them", "does": "after 8 s everyone in each patch swaps to the other", "ends": "a lilac ghost where each body stood, a flash where it lands, and both portals close with a flash"},
		"warp_seed": {"area": "the anomaly over its 1.6 m patch (gameplay)", "does": "a body that stays in it 1.5 s is thrown to a random spot; while held, lilac motes pull in round it", "ends": "the anomaly shrinks away after 30 s"},
		"bounty_banner": {"area": "a flag on a tall pole over the carrier, seen by everyone, and their 1 m ring", "does": "shows the carrier to every rival for 2 min; live through it and the squad returns, plus gems", "ends": "the flag goes with a burst of gold coins (kept) or a red puff (fell)"},
		"pilfer_pouch": {"area": "a 4 m ring at the aim (gameplay)", "does": "takes half the gems of every rival inside; coins fly off each one robbed", "ends": "at once: the ring flashes and fades"},
		"hearth_lamp": {"area": "the lamp beacon where it is set (its own model and 3 m ring, Beacons)", "does": "stands a revive beacon your squad can use", "ends": "it stays until a squad uses it; the beacon's own look shows the revive"},
		"revive_ember": {"area": "the beacon it lights at your feet (Beacons)", "does": "wakes every fallen squadmate where you stand", "ends": "at once: the beacon's revive look plays"},
		"chest_key": {"area": "the chest it opens (or a ping on the nearest locked one)", "does": "opens a locked chest beside you", "ends": "at once: a gold glint at the lock, then the chest's own opening"},
		"blight_flask": {"area": "the patch (4.5 m, gameplay) with a dark band and lime bubbles at its edge", "does": "hurts the rivals inside while it lasts", "ends": "the patch shrinks away after 25 s"},
		"cloud_raft": {"area": "the raft of cloud tiles itself", "does": "makes walkable ground over the void for 30 s", "ends": "it blinks for its last 1.5 s, then drops away"},
		"shatter_charge": {"area": "a 3 m ring where it bursts (gameplay)", "does": "a charge that bursts and hurts the rivals in it (it truly explodes)", "ends": "at once: the burst"},
		"shield_cell": {"area": "the user's shield shell (ShieldLook)", "does": "shields the user for 8 s", "ends": "the shell goes when the shield breaks or runs out"},
		"skyfall_charge": {"area": "a 6 m ring at the aim that fills, a hot disc and a falling warhead (gameplay)", "does": "after the 5 s fuse it blasts the rivals inside (it truly explodes)", "ends": "the fill reaches the rim as the warhead lands; the ring goes after the blast"},
		"stim": {"area": "self: speed streaks at the feet while it runs", "does": "makes the user faster for 6 s", "ends": "the streaks stop when the haste ends, with a last puff"},
		"thorn_wall": {"area": "the wall with spikes along the top and out of both faces", "does": "blocks the way for 20 s", "ends": "it goes after 20 s"}
	},
