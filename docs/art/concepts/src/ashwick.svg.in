<!--META {
 "name": "Cinder", "title": "Mad Pyromancer", "tag": "id ashwick  ·  female  ·  salamander-folk  ·  brawler",
 "accent": "#ff7a32", "rim": "#ffcf8a", "shadow": 105, "bust_bg": "#2a1612",
 "stage": ["#6c4a46", "#1a0f0e"],
 "relic": "the Ember Phial",
 "mat": {
  "scale": ["#a8686a", "#62343a", "#24121a"],
  "face": ["#d29488", "#8e5052", "#3a1a20"],
  "belly": ["#ffd2a0", "#e8935a", "#9a4a26"],
  "frill": ["#ffb070", "#f0522e", "#7a1a10"],
  "apron": ["#9a7454", "#5e4230", "#2a1c14"],
  "brass": ["#ffe7a6", "#c99a48", "#5a3c14"],
  "copper": ["#f2a476", "#b5603a", "#5a2814"],
  "cloth": ["#8a8a7a", "#55554c", "#262622"],
  "lens": ["#fff6b0", "#ffb43a", "#a3400e"],
  "flaskg": ["#e8ffc0", "#8ee05a", "#2f7a1e"],
  "flame": ["#fffbe0", "#ffb03a", "#e0400e"]
 },
 "glow": {"flame": "#ffa040", "green": "#9be26a"},
 "palette": [["#62343a", "charcoal scale"], ["#ff8a3a", "ember speckle"], ["#e8935a", "belly"],
             ["#f0522e", "frill"], ["#5e4230", "scorched apron"], ["#c99a48", "goggle brass"], ["#8ee05a", "the green flask"]],
 "notes": [
  ["Shape language", "A slim S-curve: a forward-leaning, wiry body balanced by a long tail behind, under one big round shape, the frill fanned out behind her head. Small busy shapes (flasks, buckles, goggles) cluster on the chest so the eye stays on her hands and face."],
  ["Signature features", "Salamander-folk: charcoal scales with ember speckles, a frill crest that flares wide when she casts, slit pupils behind cracked brass goggles, a long tail with a hot tip. A scorched leather apron, bandoliers of glowing flasks, and a copper flame-lance fed from the still on her back."],
  ["Reads in-engine", "From above: the frill is a bright orange disc on a dark body, and the tail is a second line no other hunter has. Fire is her colour, so her ember tones stay hotter and more saturated than anyone else's; the green flask is the one cool accent."]
 ]
} -->
