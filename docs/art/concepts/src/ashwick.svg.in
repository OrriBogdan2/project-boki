<!--META {
 "name": "Cinder", "title": "Mad Pyromancer", "tag": "id ashwick  ·  female  ·  salamander-folk  ·  brawler",
 "accent": "#ff7a32", "rim": "#ffcf8a", "shadow": 100, "bust_bg": "#2a1612",
 "stage": ["#6c4a46", "#1a0f0e"], "height_cm": 163, "sheet_scale": 0.95, "pos": [230, 680],
 "relic": "the Ember Phial",
 "mat": {
  "skin": ["#6a5660", "#2c2128", "#0c080a"],
  "blot": ["#ffe88a", "#ffa024", "#b8480c"],
  "belly": ["#ffd8a8", "#ec9a62", "#8a3e1e"],
  "frill": ["#ffe0a0", "#ff6a2a", "#8a1e0e"],
  "apron": ["#9a7454", "#5e4230", "#2a1c14"],
  "brass": ["#ffe7a6", "#c99a48", "#5a3c14"],
  "copper": ["#f2a476", "#b5603a", "#5a2814"],
  "cloth": ["#9a9282", "#5e584c", "#262420"],
  "lens": ["#fff6b0", "#ffb43a", "#a3400e"],
  "flaskg": ["#e8ffc0", "#8ee05a", "#2f7a1e"],
  "flame": ["#fffbe0", "#ffb03a", "#e0400e"]
 },
 "glow": {"flame": "#ffa040", "green": "#9be26a"},
 "palette": [["#2c2128", "charcoal skin"], ["#ffa024", "ember blotch"], ["#ec9a62", "throat"],
             ["#ff6a2a", "gill frills"], ["#5e4230", "scorched apron"], ["#c99a48", "goggle brass"], ["#8ee05a", "the green flask"]],
 "notes": [
  ["Shape language", "A slim, wiry S-curve: broad flat head on a long neck, narrow waist, knees bent and splayed, and a long thick tail that balances the forward lean. Her one big flare is the gills: six feathery ember stalks around the jaw that fan out like a burning ruff when she casts."],
  ["Signature features", "Salamander-folk, read at a glance: a wide flat amphibian head with a lipless grin from ear-hole to ear-hole, bulging eyes under cracked brass goggles (slit pupils), axolotl-style glowing gill-frills, a newt crest, charcoal skin with fire-salamander blotches, round-padded four-finger hands, splayed toes. A scorched apron, bandoliers of flasks, a copper flame-lance fed from the still on her back."],
  ["Reads in-engine", "From above: a dark body ringed by glowing orange gills, a blotched tail as long as she is, and hot spots on black. Fire is her colour, so her ember tones stay hotter than anyone else's; the green flask is the one cool accent."]
 ]
} -->
