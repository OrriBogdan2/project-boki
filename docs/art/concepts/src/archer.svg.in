<!--META {
 "name": "Pin", "title": "Dark Archer", "tag": "id archer  ·  female  ·  marksman",
 "accent": "#d83a4e", "rim": "#ffc2c8", "shadow": 95, "bust_bg": "#2a1a20",
 "stage": ["#86717c", "#1e171c"], "height_cm": 172, "sheet_scale": 0.9, "pos": [240, 640],
 "relic": "the Last Pin",
 "mat": {
  "cloak": ["#6e6878", "#34303b", "#141218"],
  "cloth": ["#6a6070", "#383240", "#141018"],
  "red": ["#f0606f", "#b0233a", "#560b18"],
  "leather": ["#93766d", "#523f3e", "#211819"],
  "skin": ["#f3d8c6", "#cfa08b", "#8e6153"],
  "steel": ["#b6bcc6", "#636a76", "#2c3038"],
  "bow": ["#6a5050", "#2e2225", "#110b0d"],
  "bone": ["#f6efdf", "#cfc0a2", "#857558"],
  "hair": ["#55496c", "#2b233a", "#110d18"],
  "eye": ["#ff8a95", "#c8303f", "#5a0c18"]
 },
 "glow": {"red": "#ff5a6c"},
 "palette": [["#34303b", "night cloak"], ["#b0233a", "heart red"], ["#523f3e", "oiled leather"],
             ["#636a76", "dark steel"], ["#cfc0a2", "bone nock"], ["#cfa08b", "skin"], ["#2b233a", "hair"]],
 "notes": [
  ["Shape language", "Long and narrow, 1.72 m and all edges: a lean body in fitted leather, sharp points everywhere (the hood's hooked peak, the ragged cloak tips, the knee plates, the fletching over her shoulder), crossed by one long curve, the bow. Dark big shapes; red only where the eye should land: the hood lining, the wrap, the sash, the fletching."],
  ["Signature features", "A peaked hood with a red lining and a red face wrap, so only her eyes show; a one-shoulder cloak with ragged knife-point tips; a black recurve longbow taller than she is with red grip wraps; a back quiver of red-fletched arrows; a lock of hair escaping the hood. No body or head markings."],
  ["Reads in-engine", "From above, a thin dark figure with a long diagonal line (the bow) and a red dot for a face: unlike anyone else's shape. Red sits only on the hood rim, the wrap, the sash and the fletching, so it reads as her team-neutral signature against any ground."]
 ]
} -->
