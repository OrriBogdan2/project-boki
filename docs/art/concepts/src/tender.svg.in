<!--META {
 "name": "Moosh Moosh", "title": "Fox Cub", "tag": "id tender  ·  female  ·  fox-folk  ·  support",
 "accent": "#ffb040", "rim": "#fff0c8", "shadow": 80, "bust_bg": "#2a2016",
 "stage": ["#6a6050", "#16120c"],
 "relic": "the Hearth Acorn",
 "mat": {
  "fur": ["#ffc080", "#f06a24", "#7a2a08"],
  "cream": ["#ffffff", "#f6e6cc", "#b49a78"],
  "dark": ["#5a4a44", "#2a2020", "#0e0a0a"],
  "tunic": ["#fff4dc", "#e8d2a8", "#9a8058"],
  "moss": ["#8ad8b0", "#2e8a6a", "#0e3a2c"],
  "leather": ["#b88a5a", "#7a5232", "#33200f"],
  "wood": ["#c8925a", "#8a5a30", "#3a2410"],
  "brass": ["#ffe6a0", "#d0a048", "#5a3e10"],
  "flame": ["#fffbe0", "#ffb03a", "#e0400e"],
  "eye": ["#fff0a0", "#e8a020", "#7a4a08"]
 },
 "glow": {"flame": "#ffb040"},
 "palette": [["#f06a24", "fox fur"], ["#f6e6cc", "cream"], ["#2a2020", "ear tips, boots"],
             ["#e8d2a8", "tunic"], ["#2e8a6a", "moss scarf"], ["#7a5232", "satchel"], ["#ffb03a", "hearth light"]],
 "notes": [
  ["Shape language", "Small and round: a big head, a short body, and the biggest tail in the roster, curling up behind her like a flame. Soft round shapes with two sharp triangles on top (the ears) and one tall line beside her, the lantern crook, which is twice her height."],
  ["Signature features", "Fox-folk: tall black-tipped ears, a fluffy flame-shaped tail with a glowing tip, red-orange fur with a cream muzzle, three small red cheek stripes, amber eyes. A courier's cream tunic, a moss scarf, a satchel stamped with a hearth symbol (no cross), a crook with a hanging lantern, and light cupped in her hands."],
  ["Reads in-engine", "The smallest hunter, so the tail and ears do the work: from above, a bright orange swirl with a lantern bobbing on a stick. Her glow is warm gold, kept off everyone else, so heals and light read as hers at once."]
 ]
} -->
