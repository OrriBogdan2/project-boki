<!--META {
 "name": "Moosh Moosh", "title": "Fox Cub", "tag": "id tender  ·  female  ·  fox-folk  ·  support",
 "accent": "#ffb040", "rim": "#fff0c8", "shadow": 70, "bust_bg": "#2a2016", "lw": 2.2,
 "stage": ["#7a6a52", "#1a140c"], "height_cm": 98, "sheet_scale": 1.12, "pos": [200, 690],
 "relic": "the Hearth Acorn",
 "mat": {
  "fur": ["#ffc080", "#f06a24", "#7a2a08"],
  "cream": ["#ffffff", "#f6e6cc", "#b49a78"],
  "dark": ["#5a4a44", "#2a2020", "#0e0a0a"],
  "tunic": ["#fff4dc", "#e8d2a8", "#9a8058"],
  "moss": ["#8ad8b0", "#2e8a6a", "#0e3a2c"],
  "leather": ["#b88a5a", "#7a5232", "#33200f"],
  "wood": ["#c8925a", "#8a5a30", "#3a2410"],
  "brass": ["#ffe6a0", "#d0a048", "#5a3e10"],
  "flame": ["#fffbe0", "#ffb03a", "#e0400e"],
  "eye": ["#ffe9a0", "#e08a18", "#5a2a04"],
  "paw": ["#5a4440", "#2a1e1e", "#0e0a0a"]
 },
 "glow": {"flame": "#ffb040"},
 "palette": [["#f06a24", "fox fur"], ["#f6e6cc", "cream"], ["#2a2020", "ear tips, boots"],
             ["#e8d2a8", "tunic"], ["#2e8a6a", "moss scarf"], ["#7a5232", "satchel"], ["#ffb03a", "hearth light"]],
 "notes": [
  ["Shape language", "The smallest Warden, just under a metre, and all circles: a head as wide as her shoulders are tall, stubby limbs, a round bell of a tunic, and a tail bigger than the rest of her, curling up like a flame. The only straight line is the lantern crook, taller than she is. She is never still: hopping, waving, ears up."],
  ["Signature features", "Fox-folk: big black-tipped ears, a huge fluffy tail whose tip burns, red-orange fur with a cream face, a little red flame mark on her forehead and red cheek stripes, big amber eyes and an open grin. A courier's cream tunic, a moss scarf, a satchel stamped with a hearth symbol (no cross), a crook with a hanging lantern, and a pet flame she keeps in her palm."],
  ["Reads in-engine", "The smallest hunter, so the tail and ears do the work: from above, a bright orange swirl with a lantern bobbing on a stick. Her glow is warm gold, kept off everyone else, so heals and light read as hers at once."]
 ]
} -->
