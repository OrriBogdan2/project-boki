<!--META {
 "name": "Tarek", "title": "Rock Elementalist", "tag": "id dolm  ·  male  ·  bruiser",
 "accent": "#e0923a", "rim": "#ffd6a0", "shadow": 125, "bust_bg": "#2a2220",
 "stage": ["#6c6458", "#191613"],
 "relic": "the Split Geode",
 "mat": {
  "skin": ["#c89070", "#7c4c32", "#30190d"],
  "rock": ["#b8aa98", "#776a5c", "#342c26"],
  "basalt": ["#6e6a70", "#3c3a40", "#18171b"],
  "sand": ["#f0d6a6", "#c49a62", "#6e4e28"],
  "teal": ["#6ed6c8", "#1f8f86", "#0a3d3a"],
  "cloth": ["#6a6460", "#3c3836", "#1a1817"],
  "hair": ["#4a3a34", "#241a16", "#0c0807"],
  "magma": ["#fff4c0", "#ffa040", "#c2400e"]
 },
 "glow": {"magma": "#ff9a3a"},
 "palette": [["#7c4c32", "deep brown skin"], ["#776a5c", "quarry stone"], ["#c49a62", "sandstone vest"],
             ["#1f8f86", "teal bandana"], ["#3c3836", "dust trousers"], ["#ffa040", "molten seam"], ["#241a16", "locs"]],
 "notes": [
  ["Shape language", "A slim, springy body hung between two huge blocks: the stone fists are the biggest shapes on him, the stone shoulder a third, so he reads top- and hand-heavy. Low crouch, knees bent, weight forward. Angular rock against loose, flowing cloth (bandana tails, trouser legs)."],
  ["Signature features", "A teal bandana tied over his eyes with long tails streaming behind; locs tied up in a crown; one quarried slab for a pauldron; stone fists split by molten seams that glow brighter as he channels; a sandstone vest, wrapped shins, bare feet that feel the ground. No head or body markings, no monk robes."],
  ["Reads in-engine", "From above: two big grey blocks either side of a small dark body, plus a teal flick of bandana: easy to tell from the round bulk of Bjorn or Zedran's bare shoulders. The molten seams carry his charge state; the teal is the one cool colour on an earth palette."]
 ]
} -->
