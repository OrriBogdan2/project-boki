<!--META {
 "name": "Venator", "title": "Hired Gun", "tag": "id gunslinger  ·  female  ·  marksman",
 "accent": "#ff8a4c", "rim": "#ffe0c8", "shadow": 110, "bust_bg": "#1c2430",
 "stage": ["#5c6670", "#12161b"],
 "relic": "the Paid-Up Tags",
 "mat": {
  "armor": ["#8ea2b4", "#4a5e72", "#1c2836"],
  "fatigue": ["#c8b894", "#8a7a58", "#3e3422"],
  "scarf": ["#ffc08a", "#f0642a", "#7a2408"],
  "skin": ["#d8a07a", "#a46a48", "#5a3420"],
  "hair": ["#5a4038", "#2c1e1a", "#0e0908"],
  "beret": ["#5a6aa0", "#2a3460", "#0e1228"],
  "gun": ["#7a7e86", "#3c4048", "#141619"],
  "brass": ["#ffe2a0", "#c89a40", "#5a3e10"],
  "boot": ["#5a4c40", "#2e2620", "#0e0b09"],
  "ember": ["#fff2c0", "#ffa040", "#c2400e"]
 },
 "glow": {"ember": "#ff9a3a"},
 "palette": [["#4a5e72", "plate slate"], ["#8a7a58", "fatigues"], ["#f0642a", "signal scarf"],
             ["#2a3460", "beret navy"], ["#3c4048", "gunmetal"], ["#c89a40", "brass charges"], ["#a46a48", "skin"]],
 "notes": [
  ["Shape language", "Solid and square on one side, light on the other: a heavy slate shoulder plate and vest over a lean body, so she leans asymmetric. One long straight line (the shrouded rifle) and one long wavy line (the scarf) cross her silhouette; the beret is a small tilted cap on top."],
  ["Signature features", "A tilted navy beret with a brass badge, an orange signal scarf that streams out behind, a slate plate vest with one oversized shoulder plate, a bandolier of spiked brass charges, rolled sleeves and fingerless gloves, and a long ember rifle whose shroud vents glow when it charges. Dog tags she was paid in."],
  ["Reads in-engine", "From above: the longest gun in the roster and an orange streak, on a slate-and-sand body. The vents' glow is her shot-charge tell; the scarf colour is the same orange so the eye links the two."]
 ]
} -->
