<!--META {
 "name": "Zedran", "title": "Arena King", "tag": "id juggernaut  ·  male  ·  bruiser",
 "accent": "#ff8a3a", "rim": "#ffd9a8", "shadow": 130, "bust_bg": "#3a2016",
 "stage": ["#8a6650", "#21140e"],
 "relic": "the Champion's Torc",
 "mat": {
  "skin": ["#f6cfa6", "#c48a5e", "#6e3f24"],
  "bronze": ["#ffe6a8", "#c8903e", "#5e3a12"],
  "crimson": ["#ec6a54", "#a3281f", "#470c09"],
  "leather": ["#a87650", "#62402a", "#2a180e"],
  "steel": ["#eef1f4", "#8f97a3", "#353b44"],
  "hair": ["#6a4a3a", "#3a261c", "#170e09"],
  "ember": ["#fff2c0", "#ffa040", "#c2400e"]
 },
 "glow": {"ember": "#ff9a3a"},
 "palette": [["#c48a5e", "sun skin"], ["#c8903e", "arena bronze"], ["#a3281f", "king's red"],
             ["#62402a", "strap leather"], ["#8f97a3", "blade steel"], ["#ffa040", "ember"], ["#3a261c", "beard"]],
 "notes": [
  ["Shape language", "An inverted triangle on a solid base: a huge chest and shoulders tapering to a tight waist, legs planted wide. Hard angles (the blade crown, the cleaver sword, the ram horn) against round muscle. Bare skin is the biggest shape, which no other Warden has."],
  ["Signature features", "A bronze half-helm crowned with a ring of short blades (the Arena King's crown), one ram-horned pauldron, a cleaver greatsword whose fuller glows hotter as he fights, a war chain wrapped round his left forearm, a short red cape and a strip kilt. Nothing painted on his body."],
  ["Reads in-engine", "From above: the widest shoulders after Bjorn, one horn off to the side, warm skin and bronze with a long steel bar beside him. The fuller's glow is the heat meter: dull at rest, white-orange at full burn, readable at a glance."]
 ]
} -->
