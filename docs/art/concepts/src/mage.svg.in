<!--META {
 "name": "Vireo", "title": "Storm Slayer", "tag": "id mage  ·  female  ·  skirmisher",
 "accent": "#4fd0f4", "rim": "#cff4ff", "shadow": 105, "bust_bg": "#14222c",
 "stage": ["#4e6474", "#0f151a"], "height_cm": 180, "sheet_scale": 0.88, "pos": [250, 630],
 "relic": "the Stormglass",
 "mat": {
  "jacket": ["#7a6458", "#3c2e2a", "#161010"],
  "skin": ["#f2c8a4", "#c48c66", "#7a4a30"],
  "hair": ["#b8f2ff", "#1fa8e0", "#0a3460"],
  "copper": ["#ffd0a0", "#d07a3a", "#6a3010"],
  "cargo": ["#7a7c70", "#45473f", "#1c1d19"],
  "top": ["#ff8a8a", "#c8323c", "#5a0e14"],
  "boot": ["#5a4a44", "#2c2420", "#0e0b0a"],
  "flag": ["#fff2e0", "#e8d6b8", "#8a7458"],
  "bolt": ["#ffffff", "#c8f4ff", "#3ab4f0"],
  "ink": ["#5a8ab0", "#2a4a6a", "#102030"]
 },
 "glow": {"bolt": "#8fe0ff"},
 "palette": [["#3c2e2a", "black leather"], ["#1fa8e0", "storm-blue hair"], ["#d07a3a", "copper"],
             ["#c8323c", "rebel red"], ["#45473f", "cargo"], ["#c48c66", "skin"], ["#c8f4ff", "lightning"]],
 "notes": [
  ["Shape language", "A tall, loose, confident S at 1.80 m: hip cocked, hand on it, the other arm up and crackling, the copper mast and its banner rising high behind her. Sharp zig-zags (the swept fringe, the torn sleeve, the banner's bolt, the sparks) against the straight vertical of the mast."],
  ["Signature features", "A cropped leather jacket with one sleeve torn off to show a tattoo sleeve of storm clouds and bolts (arm only, nothing on the face or head), an undercut with a long storm-blue fringe (blue, never green), hoops, chains and copper rings, a red crop top, cargo trousers, and a copper lightning-rod mast on her back flying a hand-painted rebel banner."],
  ["Reads in-engine", "From above: the mast and banner are a tall flag over her position, unique in the roster, and her bolts and dash streak share the hair's electric blue. Red top and black leather keep her readable against water and grass alike."]
 ]
} -->
