<!--META {
 "name": "Vireo", "title": "Storm Slayer", "tag": "id mage  ·  female  ·  skirmisher",
 "accent": "#5fe3c8", "rim": "#c8fff4", "shadow": 105, "bust_bg": "#14262a",
 "stage": ["#4e6a6c", "#0f1718"],
 "relic": "the Stormglass",
 "mat": {
  "jacket": ["#7a6458", "#3c2e2a", "#161010"],
  "skin": ["#f2c8a4", "#c48c66", "#7a4a30"],
  "hair": ["#a8fff0", "#22c4b0", "#0a4a44"],
  "copper": ["#ffd0a0", "#d07a3a", "#6a3010"],
  "cargo": ["#7a7c70", "#45473f", "#1c1d19"],
  "top": ["#ff8a8a", "#c8323c", "#5a0e14"],
  "boot": ["#5a4a44", "#2c2420", "#0e0b0a"],
  "flag": ["#fff2e0", "#e8d6b8", "#8a7458"],
  "bolt": ["#ffffff", "#bffff4", "#3ad6c0"]
 },
 "glow": {"bolt": "#7ff6e0"},
 "palette": [["#3c2e2a", "black leather"], ["#22c4b0", "storm teal hair"], ["#d07a3a", "copper"],
             ["#c8323c", "rebel red"], ["#45473f", "cargo"], ["#c48c66", "skin"], ["#bffff4", "lightning"]],
 "notes": [
  ["Shape language", "A tall, loose, confident S: hip cocked, one arm up, the copper mast and its banner rising high behind her. Sharp zig-zags (the hair's swept fringe, the torn sleeve, the banner's bolt, the sparks) against the straight vertical of the mast."],
  ["Signature features", "A cropped leather jacket with one sleeve torn off to show a tattoo sleeve of storm clouds and bolts (arm only, nothing on the face or head), an undercut with a long storm-teal fringe, hoops, chains and copper rings, a red crop top, cargo trousers, and a copper lightning-rod mast on her back flying a hand-painted rebel banner."],
  ["Reads in-engine", "From above: the mast and banner are a tall flag over her position, unique in the roster, and her bolts and dash streak share the hair's teal. Red top and black leather keep her readable against teal water and grass alike."]
 ]
} -->
