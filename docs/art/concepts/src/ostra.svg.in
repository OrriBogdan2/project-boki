<!--META {
 "name": "Ostra", "title": "Void Jester", "tag": "id ostra  ·  male  ·  floats  ·  controller",
 "accent": "#9b6cf0", "rim": "#c7a6ff", "shadow": 70, "float": 1, "bust_bg": "#120c1c",
 "stage": ["#43365a", "#0a0710"], "height_cm": 225, "sheet_scale": 0.8, "pos": [265, 640],
 "relic": "the Hollow Bell",
 "mat": {
  "void": ["#3d3150", "#1a1327", "#06040b"],
  "violet": ["#a07fd6", "#4b2884", "#180a2e"],
  "porcelain": ["#fbf8f4", "#d9d1d6", "#6f6380"],
  "silver": ["#e4e6ee", "#8a91a3", "#2f3442"],
  "glove": ["#5a4e6c", "#2a2238", "#0a0710"],
  "lamp": ["#f6f0ff", "#b893ff", "#3a136c"]
 },
 "glow": {"void": "#b48cff"},
 "palette": [["#1a1327", "void cloth"], ["#4b2884", "jester violet"], ["#d9d1d6", "old porcelain"],
             ["#8a91a3", "bell silver"], ["#17121f", "glove black"], ["#b48cff", "sickly void light"], ["#07050b", "the wisp"]],
 "notes": [
  ["Shape language", "The tallest Warden and the only one with no feet: a gaunt, hunched figure, all hooks and points. Two horns curl into a crescent over a long face, the ruff bristles, the shoulders ride up to the ears, and the body thins through tattered coat-tails into a smoke tail that never touches the ground. Fingers twice as long as they should be."],
  ["Signature features", "A long cracked porcelain mask whose carved grin runs up to the eyes, one violet tear; the mask always turns to face you, whichever way the body goes. A crescent horn cap, one horn drooping with a bell. A void lantern he works on a thread like a puppeteer; its light comes from below. Our own jester: no painted scar-smile, no suit, no green."],
  ["Reads in-engine", "A dark, tall, spiky shape with a white face, a horned top and a curling tail, bobbing above its own shadow. Violet light only from the lantern, the tear and the eyes, so he reads as a hole in the scene with something smiling in it."]
 ]
} -->
