<!--META {
 "name": "Ostra", "title": "Void Jester", "tag": "id ostra  ·  male  ·  floats  ·  controller",
 "accent": "#a774ff", "rim": "#dcc4ff", "shadow": 80, "float": 1, "bust_bg": "#1c1428",
 "stage": ["#5c4c74", "#120d1a"],
 "relic": "the Hollow Bell",
 "mat": {
  "void": ["#6a5a8a", "#2e2444", "#100b1a"],
  "violet": ["#d2b0ff", "#7c48cc", "#2e1456"],
  "porcelain": ["#ffffff", "#ece6f0", "#9a8eaa"],
  "silver": ["#f6f8fc", "#a9b1c2", "#474e5e"],
  "glove": ["#5a5266", "#2a2432", "#0e0b12"],
  "lamp": ["#f8eaff", "#b07aff", "#4a1a8a"]
 },
 "glow": {"void": "#b07aff"},
 "palette": [["#2e2444", "void cloth"], ["#7c48cc", "jester violet"], ["#ece6f0", "porcelain"],
             ["#a9b1c2", "bell silver"], ["#2a2432", "glove black"], ["#b07aff", "void light"], ["#14101c", "the wisp"]],
 "notes": [
  ["Shape language", "A tall, thin, top-heavy figure that tapers to nothing: the crescent cap and pointed collar make a wide, spiky top, the body narrows through the ribbons into a curling smoke tail. Long thin limbs and long fingers; nothing touches the ground."],
  ["Signature features", "A porcelain mask with a carved, too-wide grin of teeth and one violet tear; a cap whose two horns curve toward each other like a crescent moon, silver bells at the tips; a ruff of points; a diamond-pattern doublet; violet ribbons dissolving into a wisp; a void lantern that floats at his hand on a tether. Our own jester: no painted scar-smile, no suit, no green."],
  ["Reads in-engine", "The only hunter with a gap under him and no legs: a dark shape with a white face, a horned top and a curling tail, bobbing above its own shadow. Violet light comes only from the lantern, the tear and the eye-holes, so he reads as a hole in the scene."]
 ]
} -->
