<!--META {
 "name": "Tamsin", "title": "Icy Dancer", "tag": "id rimewright  ·  female  ·  controller",
 "accent": "#5fd6c4", "rim": "#e6fffb", "shadow": 90, "bust_bg": "#16203a",
 "stage": ["#526684", "#0e121c"], "height_cm": 157, "sheet_scale": 0.92, "pos": [200, 625],
 "relic": "the Rink Blade",
 "mat": {
  "dress": ["#7ae8dc", "#1f7aa0", "#121c4a"],
  "navy": ["#5a6ca8", "#22306a", "#0a1030"],
  "ice": ["#ffffff", "#c8f2ff", "#5ab0d8"],
  "teal": ["#9af6e8", "#2ab8a6", "#0a4a44"],
  "skin": ["#fff0e6", "#f0c4a6", "#a06a50"],
  "tights": ["#ffeadc", "#e6b494", "#8a5a42"],
  "hair": ["#ffffff", "#dfe8f4", "#7a8cae"],
  "silver": ["#ffffff", "#c2cad8", "#5a6274"],
  "boot": ["#ffffff", "#ece8ee", "#8e8898"]
 },
 "glow": {"ice": "#bff4ff"},
 "palette": [["#121c4a", "midnight"], ["#1f7aa0", "deep rink"], ["#c8f2ff", "rime"],
             ["#2ab8a6", "glacier teal"], ["#e6ecf6", "frost hair"], ["#e2ae8c", "skin"], ["#c2cad8", "blade silver"]],
 "notes": [
  ["Shape language", "A young athlete, 1.57 m and sixteen: long clean lines from the toe-pick to the tip of a swinging ponytail, a tight bodice that bursts into a short flared skirt, and one bright sharp shape in her hand (the ice fan). Every pose is a skating position: the toe-pick flourish, the spiral, the spin."],
  ["Signature features", "A competition dress that fades from glacier teal to midnight, crusted with frost rhinestones; sheer sparkling sleeves; a layered chiffon skirt; flesh tights; white competition skates on long blades. Frost-white hair in a high ponytail with a teal scrunchie, glitter at the eyes, a champion's grin. Our own skater: no fur stole, no bun, no cape."],
  ["Reads in-engine", "From above: a slim teal-and-navy line, a white ponytail that whips with every turn, and a bright fan of ice that opens when she casts; the skirt flares on the spin so her direction reads. Rime-white and teal stay off Bjorn, whose ice is crusted and blue."]
 ]
} -->
