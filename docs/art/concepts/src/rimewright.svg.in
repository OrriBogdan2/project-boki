<!--META {
 "name": "Tamsin", "title": "Icy Dancer", "tag": "id rimewright  ·  female  ·  controller",
 "accent": "#5fd6c4", "rim": "#e6fffb", "shadow": 95, "bust_bg": "#16203a",
 "stage": ["#4c5e7a", "#0e121c"],
 "relic": "the Rink Blade",
 "mat": {
  "navy": ["#5a6ca8", "#22306a", "#0a1030"],
  "fur": ["#ffffff", "#e8eef4", "#9aa8b8"],
  "ice": ["#ffffff", "#c8f2ff", "#5ab0d8"],
  "teal": ["#9af6e8", "#2ab8a6", "#0a4a44"],
  "skin": ["#f6d6c0", "#d8a684", "#8a5a40"],
  "hair": ["#ffffff", "#dfe6f2", "#8894aa"],
  "silver": ["#ffffff", "#c2cad8", "#5a6274"],
  "boot": ["#ffffff", "#e6e2ea", "#8e8898"]
 },
 "glow": {"ice": "#bff4ff"},
 "palette": [["#22306a", "midnight"], ["#e8eef4", "snow fur"], ["#c8f2ff", "rime"],
             ["#2ab8a6", "glacier teal"], ["#dfe6f2", "frost hair"], ["#d8a684", "skin"], ["#c2cad8", "blade silver"]],
 "notes": [
  ["Shape language", "The tallest, thinnest hunter: one long vertical line from the bun to the blade tip, with a single big soft shape at the top (the fur stole) and a single big sharp one in her hand (the open ice fan). Long, curving, trailing lines everywhere else: the skirt train and the scarf."],
  ["Signature features", "A white fur stole, a high-necked midnight leotard scattered with frost sequins, one long sheer skirt-train in glacier teal, frost-white hair in a high bun pierced by ice pins, white lace-up skates on long curved blades, and a folding fan whose ribs are thin blades of ice. Our own dancer: no hood, no cape, no armour."],
  ["Reads in-engine", "From above: a thin dark line with a white blob (the stole) and a bright fan of ice that opens when she casts; the teal train streams behind her skates so her glide direction reads. Rime-white and teal stay off the other cold hero, Bjorn, whose ice is crusted and blue."]
 ]
} -->
