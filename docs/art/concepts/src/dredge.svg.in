<!--META {
 "name": "Dredge", "title": "Broken Abomination", "tag": "id dredge  ·  machine  ·  tank",
 "accent": "#e0b040", "rim": "#ffd0dc", "shadow": 165, "bust_bg": "#1a1214",
 "stage": ["#5e5250", "#120e0e"],
 "relic": "the Leaking Heart",
 "mat": {
  "brass": ["#c2a46a", "#6e5428", "#20160a"],
  "rust": ["#b0705a", "#6a3424", "#220c06"],
  "steel": ["#8c929c", "#4c5058", "#1a1c20"],
  "ooze": ["#4a2a46", "#1c0f1e", "#060308"],
  "rope": ["#d8c08a", "#9a8050", "#4a3a20"],
  "glass": ["#ffd6e2", "#ff3a6a", "#5a0a20"]
 },
 "glow": {"rot": "#ff3a6a"},
 "palette": [["#6e5428", "tarnished brass"], ["#6a3424", "rust"], ["#4c5058", "hull steel"],
             ["#1c0f1e", "the ooze"], ["#ff3a6a", "rot light"], ["#9a8050", "hauling rope"], ["#e0b040", "lamp brass"]],
 "notes": [
  ["Shape language", "A boulder on stumps: one huge round mass (boiler body and shoulders) hunched so far forward the round helm sits low in front of it, with arms long enough to drag. Circles everywhere (helm, portholes, drum, rivets), broken by jagged tears where the plates have split."],
  ["Signature features", "A brass diving helm with one cracked porthole and a single red eye inside; a winch drum on one shoulder whose rope ends in a cargo hook; a flared blunderbuss for a right forearm; a three-fingered grab-claw; split plates leaking black ooze lit from within by red rot-light. Nothing animal, no face paint, no hat or bow tie: a machine, not a mascot."],
  ["Reads in-engine", "From above: the biggest round shape in the roster with a drum bump on one side and a long arm on the other. The red light only shows through cracks, the porthole and the chest grille, so as he grows with knocks the cracks can widen and glow brighter: the growth is readable."]
 ]
} -->
