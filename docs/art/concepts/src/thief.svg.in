<!--META {
 "name": "Sable", "title": "Silver Thief", "tag": "id thief  ·  female  ·  duelist",
 "accent": "#c9a0ff", "rim": "#efe2ff", "shadow": 100, "bust_bg": "#221a30",
 "stage": ["#6a6280", "#15121c"], "height_cm": 168, "sheet_scale": 0.9, "pos": [225, 650],
 "relic": "the Moonsilver Key",
 "mat": {
  "coat": ["#7a6c9a", "#40355c", "#191326"],
  "silver": ["#ffffff", "#c4c8d4", "#5c6274"],
  "skin": ["#f6dcc8", "#d6a88e", "#8e5e4c"],
  "hair": ["#ffffff", "#d8dce6", "#7c8294"],
  "black": ["#5a5664", "#2a2830", "#0e0d12"],
  "plum": ["#c39ae8", "#7c4ea8", "#341a4e"],
  "wood": ["#9a7454", "#5a3e2a", "#261a10"],
  "bolt": ["#ffffff", "#d9c2ff", "#7a52c8"]
 },
 "glow": {"bolt": "#c9a0ff"},
 "palette": [["#40355c", "dusk coat"], ["#c4c8d4", "silver"], ["#d8dce6", "white braid"],
             ["#7c4ea8", "plum lining"], ["#2a2830", "gloves, boots"], ["#d6a88e", "skin"], ["#c9a0ff", "arc bolt"]],
 "notes": [
  ["Shape language", "Light and quick, 1.68 m: a narrow body on long legs with two long trailing lines, the white braid and the split coat-tails, so she reads as motion even standing. Small sharp shapes (the cat-eye mask, the crossbow limbs, the ring-bound braid) and no big masses; a cocky tilt to everything."],
  ["Signature features", "A silver domino mask, a single long white braid bound in silver rings, a cropped dusk-violet tailcoat with long split tails and a plum lining, twin hand crossbows that fire arcing bolts, a belt of picks and keys. Nothing hooded: the hood and cape belong to no one now, Pin owns the hood."],
  ["Reads in-engine", "From above: a slim violet body with a white streak (the braid) and two coat-tails that swing out when she cartwheels. Silver catches the light on the mask, the crossbows and the rings; the arc bolts are the same lilac as her accent."]
 ]
} -->
