extends RefCounted
## --step-contacts-gen: writes content/rules/step_contacts.json, the step cue table WardenSteps plays from. Per Hero
## with clips, the real model (WardenClips through Warden/Sync, fixed 1/60 s frames) walks and runs each of the 8
## ways and crouch-walks each of the 4, so every walk, run and crouch-walk loop plays as the game plays it (the
## stride WardenGait lays over the walk and run moves where the foot is lowest); each frame an ankle reaches its
## lowest point (`plants`) the phase of the loop the legs show is noted, and each foot's phases are averaged into one
## plant per cluster (side 0 left, 1 right). A hover (warden_anim "rig_root": Motley) has the low of his hips' bob
## instead (side 2). Never touches the save.

const OUT := "content/rules/step_contacts.json"
const DOC := ("Generated by --step-contacts-gen (do not edit): per Hero art, each walk, run and crouch-walk loop's foot "
		+ "plants as [phase 0..1, side 0 left / 1 right / 2 hips] where the ankle (Motley: the hips) is lowest as the game "
		+ "plays it. WardenSteps cues the step there (docs/AUDIO.md, Footsteps); --step-contacts-check holds it to 2 frames.")
const DT := 1.0 / 60.0
const WARM_S := 2.4          # s at a speed before sampling: three of WardenGait.MEAN_TAU, so the stride has settled
const SAMPLE_S := 4.0        # s sampled per way
const FEET := ["L", "R"]     # the ankles: the end of each shin (the contract has no foot bone)
const HALF := 0.5            # a foot below half its height range is on its way down to a plant, or on it
## Of the range: within this of a stretch's lowest the foot has reached it (a flat sole holds its low for several
## frames: the first of them is the plant).
const REACH := 0.05
const KEEP := 0.2            # of the range: a stretch whose low sits higher than this over the lowest is a lift's dip
const CLUSTER := 0.1         # of a loop: phases of one foot this close are the same plant
const MINOR := 0.5           # a cluster with fewer phases than this of the foot's biggest is a stray (a blend settling)
const ON_POINT := 0.05       # blend space: a loop is read only this close to its own point (not mid-blend)
const WAYS := [Vector2(0, 1), Vector2(0, -1), Vector2(-1, 0), Vector2(1, 0), Vector2(-0.7071, 0.7071),
		Vector2(0.7071, 0.7071), Vector2(-0.7071, -0.7071), Vector2(0.7071, -0.7071)]


## The frames of `ys` where it reaches each of its lows: per stretch below HALF of its range whose low is within KEEP
## of the lowest, the first frame within REACH of that stretch's low. --step-contacts-check reads plants with it too.
static func plants(ys: PackedFloat32Array, keep := KEEP) -> PackedInt32Array:
	var lo := INF
	var hi := -INF
	for y in ys:
		lo = minf(lo, y)
		hi = maxf(hi, y)
	var cut := lo + HALF * (hi - lo)
	var out := PackedInt32Array()
	var i := 0
	while i < ys.size():
		if ys[i] > cut:
			i += 1
			continue
		var j := i
		var low := INF
		while j < ys.size() and ys[j] <= cut:
			low = minf(low, ys[j])
			j += 1
		for k in range(i, j):
			if low <= lo + keep * (hi - lo) and ys[k] <= low + REACH * (hi - lo):
				out.append(k)
				break
		i = j
	return out


## How high tracked point `b` is on the skeleton: "hips", or the ankle of side "L" / "R" (the shin's end, as
## --anim-audit reads it).
static func height(sk: Skeleton3D, b: String) -> float:
	if b == "hips":
		return sk.get_bone_global_pose(WardenSkeleton.find(sk, "hips")).origin.y
	var shin := WardenSkeleton.find(sk, "shin." + b)
	var thigh := WardenSkeleton.find(sk, "thigh." + b)
	var gs := sk.get_bone_global_pose(shin)
	var leg := (sk.get_bone_global_rest(shin).origin - sk.get_bone_global_rest(thigh).origin).length()
	return gs.origin.y + gs.basis.y.normalized().y * leg


## The points a Hero's step reads: its hips for a hover, else its two ankles.
static func tracked(clips: WardenClips) -> Array:
	return ["hips"] if bool(clips.d.get("rig_root", false)) else FEET


## Runs model `m` in anim state `st` for WARM_S, then SAMPLE_S in fixed frames. Each frame the step due is taken the
## way HunterAnim takes it (before the clips advance), then the clips advance and the tracked points are read.
## Returns {"cues": [[frame, side], ...], "ys": per tracked point its heights, "at": per frame [clip, phase] of the
## loop `probe` (a WardenSteps) sees the legs show, or [] when none shows on its own (off its blend point)}.
static func sample(m: Node3D, clips: WardenClips, st: Dictionary, probe: WardenSteps) -> Dictionary:
	var sync := m.get_node("Warden/Sync")
	var sk := WardenGlb.skeleton(m.get_node("Warden"))
	var bones := tracked(clips)
	m.set_meta(WardenClips.STATE, st)
	clips.loco_pos = Vector2.ZERO
	for k in int(WARM_S / DT):
		sync.call("_process", DT)
	WardenSteps.take(m)
	var cues: Array = []
	var at: Array = []
	var rows: Array = bones.map(func(_b): return [])
	for f in int(SAMPLE_S / DT):
		var side := WardenSteps.take(m)
		if side >= 0:
			cues.append([f, side])
		sync.call("_process", DT)
		var crouched := clips.crouch_w >= 0.5
		var pos := clips.crouch_pos if crouched else clips.loco_pos
		var p := probe.showing("crouch_loco" if crouched else "loco", pos)
		at.append([p[5], probe.phase(p)] if not p.is_empty() and pos.distance_to(p[0]) <= ON_POINT else [])
		for i in bones.size():
			rows[i].append(height(sk, bones[i]))
	m.set_meta(WardenClips.STATE, {})
	return {"cues": cues, "ys": rows.map(func(r): return PackedFloat32Array(r)), "at": at}


## The model of Hero `id` under `holder`, its Sync stepped only by hand; null when it has no loco clips.
static func model(main: Node, holder: Node3D, id: String) -> Node3D:
	var m := Models.hunter(Arch.weight(id), Data.TEAM_COLORS[0], Arch.signature(id), "", PlayerLook.neutral(), id)
	m.set_meta("anim_seed", 1)
	holder.add_child(m)
	var sync := m.get_node_or_null("Warden/Sync")
	if sync:
		sync.set_process(false)     # (only fixed steps move the clips: a real frame's dt would shift their phase)
	for k in 3:
		await main.get_tree().process_frame
	var clips: WardenClips = sync.get("clips") if sync else null
	if clips == null or not clips.d.has("loco"):
		m.free()
		return null
	return m


## The anim state moving way `way` (blend space: x right, y forward) at `spd` m/s, facing -Z.
static func moving(way: Vector2, spd: float, crouched: bool) -> Dictionary:
	return {"vel": Vector3(way.x, 0.0, -way.y) * spd, "face": 0.0, "grounded": true, "crouch": 1.0 if crouched else 0.0}


func run(main: Node) -> void:
	Save.no_write = true
	var holder := Node3D.new()
	main.add_child(holder)
	var table := {}
	for id in Arch.ids():
		var art := WardenGlb.art(id)
		if table.has(art):
			continue
		var m: Node3D = await model(main, holder, id)
		if m != null:
			table[art] = _hero(m, art)
			m.free()
	var f := FileAccess.open("res://" + OUT, FileAccess.WRITE)
	f.store_string(_text(table))
	f.close()
	print("STEP_CONTACTS_GEN ", table.size(), " Heroes -> ", OUT)
	main.get_tree().quit(0 if table.size() > 0 else 1)


## One Hero's loops: clip name -> [[phase, side], ...] in phase order.
func _hero(m: Node3D, art: String) -> Dictionary:
	var clips: WardenClips = m.get_node("Warden/Sync").get("clips")
	var lc: Dictionary = clips.d["loco"]
	var hover := bool(clips.d.get("rig_root", false))
	var loops := {}
	for nm in _loops(clips.d):
		loops[nm] = []
	var probe := WardenSteps.make(m, clips.tree, loops)
	var seen := {}       # clip -> side -> phases at its plants
	var runs: Array = []
	for way in WAYS:
		for spd in [float(lc.get("walk_speed", 2.2)), float(lc.get("run_speed", 4.6))]:
			runs.append(moving(way, spd, false))
	if clips.d.has("crouch"):
		for way in WAYS.slice(0, 4):
			runs.append(moving(way, float(clips.d["crouch"].get("speed", 2.4)), true))
	for st in runs:
		var got := sample(m, clips, st, probe)
		for i in (got["ys"] as Array).size():
			for fr in plants(got["ys"][i]):
				var at: Array = got["at"][fr]
				if not at.is_empty():
					var by: Dictionary = seen.get_or_add(at[0], {})
					(by.get_or_add(2 if hover else i, []) as Array).append(float(at[1]))
	var row := {}
	for nm in loops:
		var marks: Array = []
		for side in seen.get(nm, {}):
			for u in _clusters(seen[nm][side]):
				marks.append([u, side])
		marks.sort_custom(func(x, y): return float(x[0]) < float(y[0]))
		row[nm] = marks
		print("STEP_CONTACTS %-8s %-22s %s" % [art, nm, marks])
	return row


## Phases (0..1, wrapping) gathered into plants: each run of phases closer than CLUSTER, as its circular mean (not
## the MINOR ones).
static func _clusters(us: Array) -> Array:
	us.sort()
	var groups: Array = []
	for u in us:
		if groups.is_empty() or float(u) - float(groups[-1][-1]) > CLUSTER:
			groups.append([])
		groups[-1].append(u)
	if groups.size() > 1 and float(groups[0][0]) + 1.0 - float(groups[-1][-1]) <= CLUSTER:
		groups[0] += groups.pop_back()
	var most := 0
	for g in groups:
		most = maxi(most, g.size())
	var out: Array = []
	for g in groups:
		if g.size() < MINOR * most:
			continue
		var v := Vector2.ZERO
		for u in g:
			v += Vector2.from_angle(TAU * float(u))
		out.append(fposmod(snappedf(v.angle() / TAU, 0.0001), 1.0))
	return out


## The table as JSON, one line per loop.
static func _text(table: Dictionary) -> String:
	var heroes: Array = [" \"_doc\": %s" % JSON.stringify(DOC)]
	for art in table:
		var rows: Array = []
		for nm in table[art]:
			rows.append("  %s: %s" % [JSON.stringify(nm), JSON.stringify(table[art][nm])])
		heroes.append(" %s: {\n%s\n }" % [JSON.stringify(art), ",\n".join(rows)])
	return "{\n%s\n}\n" % ",\n".join(heroes)


## Every walk, run and crouch-walk loop of warden_anim data `d`.
static func _loops(d: Dictionary) -> Array:
	var out: Array = []
	var groups: Array = [d["loco"].get("walk", {}), d["loco"].get("run", {})]
	if d.has("crouch"):
		groups.append(d["crouch"].get("walk", {}))
	for g in groups:
		for nm in (g as Dictionary).values():
			if not nm in out:
				out.append(String(nm))
	return out
