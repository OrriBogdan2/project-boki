#!/usr/bin/env python3
"""Minimal `unzip` for runners that have none and no sudo (tools/ci/ci_env.sh puts this on PATH only then).
Supports what the repo's scripts use: unzip [-q] [-o] FILE [-d DIR] [MEMBER_PATTERN...]. Keeps unix permission bits."""
import fnmatch
import os
import stat
import sys
import zipfile

args = sys.argv[1:]
dest, zpath, pats, i = ".", None, [], 0
while i < len(args):
    a = args[i]
    if a == "-d":
        dest = args[i + 1]
        i += 2
        continue
    if a in ("-q", "-qq", "-o", "-n"):
        i += 1
        continue
    if zpath is None:
        zpath = a
    else:
        pats.append(a)
    i += 1
if zpath is None:
    sys.exit("unzip shim: no zip file given")
with zipfile.ZipFile(zpath) as z:
    names = [n for n in z.namelist() if not pats or any(fnmatch.fnmatchcase(n, p) for p in pats)]
    if pats and not names:
        sys.exit("unzip shim: no member matches " + " ".join(pats))
    for n in names:
        mode = z.getinfo(n).external_attr >> 16
        if stat.S_ISLNK(mode):  # macOS app bundles carry symlinks: the member's data is the link target
            link = os.path.join(dest, n)
            os.makedirs(os.path.dirname(link) or ".", exist_ok=True)
            if os.path.lexists(link):
                os.remove(link)
            os.symlink(z.read(n).decode(), link)
            continue
        target = z.extract(n, dest)
        if mode and not n.endswith("/"):
            os.chmod(target, mode & 0o7777)
